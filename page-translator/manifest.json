{
  "manifest_version": 3,
  "name": "一键网页翻译",
  "version": "1.3.0",
  "description": "自由选择原文和目标语言，默认英语转简体中文，支持动态内容与恢复原文。",
  "permissions": ["storage", "activeTab"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "一键网页翻译", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["languages.js", "local-translator.js", "content.js"],
    "all_frames": true,
    "match_about_blank": true,
    "run_at": "document_idle"
  }]
}
